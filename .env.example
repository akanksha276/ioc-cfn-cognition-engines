# CFN Service (required for production)
# URL for CFN service. If not set, uses in-process mock repository.
# CFN provides access to Management Plane, Knowledge Memory, and metrics storage.
CFN_URL=http://localhost:9002
# Legacy fallback (deprecated): Use CFN_URL instead
MOCKED_DB_BASE_URL=

# Cognition Engine Registration & Heartbeat
# If CFN_URL is set, CEs automatically register on startup and send periodic heartbeats to maintain "online" status
# CE version reported to Management Plane during registration (default: 1.2.3)
CE_VERSION=1.2.3
# Heartbeat interval in seconds - how often to ping Management Plane (default: 30)
# Lower values = faster offline detection, but more network traffic
CE_HEARTBEAT_INTERVAL_SEC=30
# Public hostname/IP where the CE is accessible by CFN (defaults to localhost)
# For Docker/K8s, use the service name or external IP
COGNITION_ENGINE_HOST=localhost
# Port where the CE HTTP server is running (defaults to 9004)
COGNITION_ENGINE_PORT=9004

# LLM Configuration (litellm provider/model format)
# LLM_MODEL accepts any litellm-compatible string: openai/gpt-4o, anthropic/claude-sonnet-4-6,
# azure/gpt-4o, ollama/llama3, bedrock/anthropic.claude-3-sonnet-20240229-v1:0, etc.
LLM_MODEL=openai/gpt-4o
# API key for the LLM provider. Leave empty for local providers (Ollama, vllm) when using LLM_BASE_URL.
LLM_API_KEY=
# Custom base URL for local LLMs or a LiteLLM proxy (e.g. http://localhost:11434 for Ollama).
LLM_BASE_URL=
# Completion temperature 0–2 (default 0 = deterministic). Set LLM_TEMPERATURE to override.
# LLM_TEMPERATURE=0.7

# Local embedding model (optional)
# Path to granite-embedding-30m-english folder. If set, ingestion and evidence use this instead of downloading from Hugging Face.
# Use repo-relative path when running from repo root (e.g. granite-embedding-30m-english) or an absolute path.
# Leave empty to use Hugging Face (or auto-detect repo granite-embedding-30m-english if present).
EMBEDDING_MODEL_PATH=

# Knowledge Processor Configuration (ingestion)
# Enable embedding generation for concepts (true/false, default: true)
ENABLE_EMBEDDINGS=true
# Enable semantic deduplication of concepts and relations (true/false, default: true)
ENABLE_DEDUP=true
# Cosine similarity threshold for deduplication (0.0-1.0, default: 0.95)
# Higher values = stricter matching, lower values = more aggressive deduplication
SIMILARITY_THRESHOLD=0.90

# Evidence Gathering Tuning Parameters
# Maximum depth for evidence graph traversal
EG_MAX_DEPTH=4
# Maximum number of paths to explore during evidence gathering
EG_PATH_LIMIT=20
EVIDENCE_RAG_TOP_K=10

# RAG retrieval when rag_cache_layer is set (parallel to graph evidence)
# EVIDENCE_RAG_TOP_K=5
# EVIDENCE_RAG_TIMEOUT_SEC=60

# Semantic Negotiation Agent
# Hard cap on SAO rounds per session (default: 0 = no cap).
# When unset or 0, the step budget is computed automatically from
# negotiation complexity (n_agents × n_issues × ln(options)).
# Set to a positive integer to enforce an upper bound, e.g.:
# NEGOTIATION_N_STEPS=500
NEGOTIATION_N_STEPS=0

# NegMAS negotiator strategy class name (default: BoulwareTBNegotiator)
# Available: BoulwareTBNegotiator  — holds extreme offer, concedes late (sub-linear)
#            ConcederTBNegotiator  — concedes quickly (super-linear)
#            LinearTBNegotiator    — concedes at a constant linear rate
#            NaiveTitForTatNegotiator — mirrors opponent's concession size
#            SimpleTitForTatNegotiator
#            AspirationNegotiator  — time-based, ignores opponent offers
#            CABNegotiator         — optimal & complete (game-theoretic)
#            CANNegotiator         — optimal conceding-accepting not-worse
#            ToughNegotiator       — never concedes, only its best offer
#            NiceNegotiator        — accepts everything
#            MiCRONegotiator       — minimal rational concession
NEGOTIATOR_STRATEGY=ConcederTBNegotiator

# SSL/TLS Configuration (optional, for corporate environments)
# Uncomment and set these if you're behind a corporate proxy with custom CA certificates
# Path to CA certificate bundle file (for requests, curl, SSL verification)
# REQUESTS_CA_BUNDLE=/path/to/ca-bundle.crt
# SSL_CERT_FILE=/path/to/ca-bundle.crt
# CURL_CA_BUNDLE=/path/to/ca-bundle.crt
# Disable SSL verification for httpx/OpenAI clients (not recommended for production)
# HTTPX_VERIFY=false
# OPENAI_VERIFY_SSL=false
