# ============================================================================
# semantic_negotiation — environment variables
# Copy this file to .env and fill in real values.
# settings.py reads: LLM_MODEL, LLM_API_KEY, LLM_BASE_URL, LLM_TEMPERATURE
# ============================================================================

# ----------------------------------------------------------------------------
# LLM Provider — LiteLLM proxy (recommended) or direct provider
# ----------------------------------------------------------------------------

# API key registered on the LiteLLM proxy (or a direct provider API key).
LLM_API_KEY=

# Base URL of the LiteLLM proxy (leave empty for direct provider access,
# e.g. OpenAI, Anthropic, Bedrock, Ollama).
# Example proxy:   LLM_BASE_URL=https://llm-proxy.prod.outshift.ai
# Example Ollama:  LLM_BASE_URL=http://localhost:11434
LLM_BASE_URL=

# Generator model — LiteLLM model string used by the negotiation server
# (intent discovery, options generation, agent decide calls).
# Use the exact model ID returned by GET /v1/models on your proxy, or any
# litellm-compatible string for direct access.
#
# Examples:
#   Via proxy  : openai/bedrock/global.anthropic.claude-sonnet-4-5-20250929-v1:0
#   Direct     : anthropic/claude-sonnet-4-5-20250929-v1:0
#   OpenAI     : openai/gpt-4o
#   Ollama     : ollama/llama3
LLM_MODEL=openai/gpt-4o

# Completion temperature 0–2 (default 0 = deterministic). Set LLM_TEMPERATURE to override.
# LLM_TEMPERATURE=0.7

# ----------------------------------------------------------------------------
# Evaluation pipeline (eval_pipeline.py)
# ----------------------------------------------------------------------------

# Judge model — used by eval_pipeline.py to score negotiation outputs against
# the gold dataset. Should be a stronger or different model than LLM_MODEL to
# avoid self-evaluation bias.
#
# Examples:
#   Via proxy  : openai/bedrock/global.anthropic.claude-opus-4-5-20251101-v1:0
#   Direct     : anthropic/claude-opus-4-5-20251101-v1:0
#   OpenAI     : openai/gpt-4o
#
# Falls back to OPENAI_MODEL, then settings.llm_model if not set.
JUDGE_MODEL=
